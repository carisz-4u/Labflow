# Salin file ini menjadi ".env" terus sesuaikan dengan pengaturan MySQL mu
# File .env WAJIB ada dan diisi dengan benar website ini butuh MySQL untuk berjalan

# Port server backend
PORT=3000

# WAJIB diganti dengan string acak yang panjang kalau mau dipakai di server produksi.
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# ---- Koneksi MySQL ----
# Database akan DIBUAT OTOMATIS oleh website kalau belum ada
# asalkan user di bawah ini punya izin CREATE DATABASE.


DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=asetlab
