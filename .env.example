# Salin file ini menjadi ".env" lalu sesuaikan dengan pengaturan MySQL di komputer/servermu.
# File .env WAJIB ada dan diisi dengan benar — aplikasi ini butuh MySQL untuk berjalan
# (berbeda dari versi sebelumnya yang otomatis pakai file lokal tanpa perlu setup database).

# Port server backend
PORT=3000

# Kunci rahasia untuk menandatangani token login (JWT).
# WAJIB diganti dengan string acak yang panjang sebelum dipakai di server produksi.
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# ---- Koneksi MySQL ----
# Database akan DIBUAT OTOMATIS oleh aplikasi kalau belum ada (tidak perlu bikin manual),
# asalkan user di bawah ini punya izin CREATE DATABASE.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=asetlab
